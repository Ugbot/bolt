#version 450
// BLLM-47: Vulkan matmul+dequant compute shader, Int4 weight path.
// Two 4-bit codes packed per byte, LOW NIBBLE FIRST (our exact layout --
// see bolt_compute.h's matmul_row_dot_f32 Int4 case and
// boltllm::quant::QuantTypes.h's packing convention this must match
// byte-for-byte). bitfieldExtract on the UNSIGNED byte (not int) avoids
// sign extension -- the nibble is an unsigned 0..15 code; kInt4DequantOffset
// (8) is subtracted manually, same as the CPU/ROCm paths.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer WeightBuf { uint weight_packed[]; };
layout(set = 0, binding = 1) readonly buffer ScaleBuf { float scale[]; };
layout(set = 0, binding = 2) readonly buffer ActBuf { float activation[]; };
layout(set = 0, binding = 3) writeonly buffer OutBuf { float out_data[]; };

layout(push_constant) uniform PushConstants {
    int cols;
} pc;

shared float partial_sum[256];

const int kInt4DequantOffset = 8;

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint cols = uint(pc.cols);
    uint bytes_per_row = (cols + 1u) / 2u;
    uint words_per_row = (bytes_per_row + 3u) / 4u;
    uint row_word_offset = row * words_per_row;

    float acc = 0.0;
    for (uint i = tid; i < cols; i += gl_WorkGroupSize.x) {
        uint byte_index = i >> 1u;
        uint word = weight_packed[row_word_offset + (byte_index >> 2u)];
        uint byte_val = bitfieldExtract(word, int((byte_index & 3u) * 8u), 8);
        uint nibble = ((i & 1u) == 0u) ? (byte_val & 0xFu) : (byte_val >> 4u);
        int v = int(nibble) - kInt4DequantOffset;
        acc += activation[i] * float(v);
    }
    partial_sum[tid] = acc;
    barrier();
    for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride >>= 1u) {
        if (tid < stride) partial_sum[tid] += partial_sum[tid + stride];
        barrier();
    }
    if (tid == 0u) out_data[row] = partial_sum[0] * scale[row];
}
