#version 450
// BLLM-47 / BLLM-160: Vulkan matmul+dequant compute shader, F32 weight path.
// One workgroup per output row; threads stride over `cols`. Reduction uses
// llama.cpp's subgroupAdd approach: an in-subgroup reduction (subgroupAdd, one
// hardware instruction on RDNA/NV) followed by a small cross-subgroup combine
// in shared memory -- fewer barriers than the shared-memory tree it replaces.
// Numerically identical to bolt_compute.h's matmul_row_dot_f32 (plain dot).
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer WeightBuf { float weight[]; };
layout(set = 0, binding = 1) readonly buffer ActBuf { float activation[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

layout(push_constant) uniform PushConstants {
    int cols;
} pc;

// One slot per subgroup; 256 threads / (min subgroup size 4) = 64 max.
shared float sg_partials[64];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint cols = uint(pc.cols);
    uint row_offset = row * cols;

    float acc = 0.0;
    for (uint i = tid; i < cols; i += gl_WorkGroupSize.x) {
        acc += activation[i] * weight[row_offset + i];
    }

    // In-subgroup reduction, then the first lane of each subgroup publishes.
    float sg_sum = subgroupAdd(acc);
    if (subgroupElect()) {
        sg_partials[gl_SubgroupID] = sg_sum;
    }
    barrier();

    // Thread 0 combines the per-subgroup partials.
    if (tid == 0u) {
        float total = 0.0;
        for (uint s = 0u; s < gl_NumSubgroups; ++s) {
            total += sg_partials[s];
        }
        out_data[row] = total;
    }
}
