# BoltLimits.cmake — build-time defaults for a repo's Limits registry table.
#
#   bolt_limits_build_overrides(<target> <PREFIX> <header> <macro>)
#
# Collects every CMake variable named <PREFIX>_LIMIT_<NAME> (set with
# -D<PREFIX>_LIMIT_<NAME>=<decimal>) into "name=value;..." (NAME lower-cased)
# and writes <binary>/generated/limits/<header> defining <macro> as that
# string. The repo's limits header includes it with __has_include and passes
# the macro to BOLT_LIMITS_TABLE_BUILD, which checks every entry against the
# table at compile time. The directory is added to <target>'s include path
# (INTERFACE for interface libraries, else PUBLIC).
#
# Example: cmake -DMARBLEDB_LIMIT_SEAL_ROWS=131072 -DGESTALT_LIMIT_MAX_QUERY_BYTES=16777216 ..
include_guard(GLOBAL)

function(bolt_limits_build_overrides target prefix header macro)
    get_cmake_property(_vars VARIABLES)
    set(_entries "")
    foreach(_v IN LISTS _vars)
        if(_v MATCHES "^${prefix}_LIMIT_([A-Z0-9_]+)$")
            set(_name "${CMAKE_MATCH_1}")
            set(_val "${${_v}}")
            if(NOT _val MATCHES "^[0-9]+$")
                message(FATAL_ERROR "${_v}=${_val}: a limit override must be a decimal integer")
            endif()
            string(TOLOWER "${_name}" _lname)
            list(APPEND _entries "${_lname}=${_val}")
            message(STATUS "${prefix} limit ${_lname} build default ${_val}")
        endif()
    endforeach()
    list(SORT _entries)
    list(JOIN _entries ";" _joined)
    set(_dir "${CMAKE_BINARY_DIR}/generated/limits")
    file(CONFIGURE OUTPUT "${_dir}/${header}"
         CONTENT "// Generated by bolt_limits_build_overrides; do not edit.\n#pragma once\n#ifndef ${macro}\n#define ${macro} \"${_joined}\"\n#endif\n"
         @ONLY)
    get_target_property(_type ${target} TYPE)
    if(_type STREQUAL "INTERFACE_LIBRARY")
        target_include_directories(${target} INTERFACE $<BUILD_INTERFACE:${_dir}>)
    else()
        target_include_directories(${target} PUBLIC $<BUILD_INTERFACE:${_dir}>)
    endif()
endfunction()
